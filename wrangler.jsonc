{
 "$schema":"node_modules/wrangler/config-schema.json",
 "name":"ai-diplomacy-1914",
 "main":"worker/index.ts",
 "compatibility_date":"2026-10-08",
 "assets":{"directory":"./dist","binding":"ASSETS","not_found_handling":"single-page-application","run_worker_first":["/api/*"]},
 "ai":{"binding":"AI","remote":true},
 "d1_databases":[{"binding":"DB","database_name":"diplomacy","database_id":"cb2de957-ef14-46eb-8c0f-52baf9b4023a","migrations_dir":"migrations"}],
 "vars":{"AI_MODEL":"@cf/zai-org/glm-4.7-flash","LOCAL_AI_ENABLED":"false"},
 "observability":{"enabled":true,"traces":{"enabled":true}},
 "build":{"command":"npm run build"}
}
